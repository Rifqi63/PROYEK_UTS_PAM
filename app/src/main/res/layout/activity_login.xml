<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☕"
            android:textSize="42sp"
            android:layout_marginTop="25dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:textColor="#3B241C"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masuk kembali dan nikmati kopi serta camilan favoritmu."
            android:textColor="#8D796B"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_signup_card"
            android:elevation="4dp"
            android:padding="20dp"
            android:layout_marginTop="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#3B241C"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Masukkan email"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textSize="14sp"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#C58B55"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#3B241C"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="Masukkan password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textSize="14sp"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#C58B55"/>

            <Button
                android:id="@+id/btnLoginNow"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_primary_button"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvBackRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="25dp"
            android:text="Don't have an account? Register"
            android:textColor="#8D796B"
            android:textSize="14sp"/>

    </LinearLayout>

</ScrollView>