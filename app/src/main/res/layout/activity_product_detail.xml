<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#4B3025"
                android:textSize="36sp"
                android:background="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Detail Produk"
                android:textColor="#4B3025"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="♡"
                android:textColor="#8B5E46"
                android:textSize="28sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Product Image -->
        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="25dp"
            android:background="#EFE2D4"
            android:scaleType="centerCrop"
            android:src="@drawable/caramel_latte"
            android:contentDescription="Foto produk" />

        <!-- Product Information -->
        <TextView
            android:id="@+id/tvProductCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="COFFEE"
            android:textColor="#A4775B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Caramel Latte"
            android:textColor="#3D2920"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProductPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rp 25.000"
            android:textColor="#A4775B"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Deskripsi Produk"
            android:textColor="#3D2920"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProductDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="5dp"
            android:text="Perpaduan espresso, susu creamy, dan manisnya saus caramel yang cocok menemani aktivitasmu."
            android:textColor="#806D61"
            android:textSize="14sp" />

        <!-- Quantity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Jumlah Pesanan"
            android:textColor="#3D2920"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/btnMinus"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="−"
                android:textColor="#704832"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="#3D2920"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPlus"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#704832"
                android:textSize="24sp" />

        </LinearLayout>

        <!-- Add to Cart -->
        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#79513B"
            android:text="Tambah ke Keranjang"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>