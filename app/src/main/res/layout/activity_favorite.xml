<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBackFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_home_chip"
                android:padding="11dp"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR COLLECTION"
                    android:textColor="#A66A35"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="My Favorites"
                    android:textColor="#38251C"
                    android:textSize="23sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- DESCRIPTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your favorite coffee and snacks, all in one place."
            android:textColor="#927967"
            android:textSize="13sp"/>

        <!-- SECTION TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Favorite Menu"
                android:textColor="#38251C"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvFavoriteCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Items"
                android:textColor="#A66A35"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- EMPTY STATE -->
        <LinearLayout
            android:id="@+id/layoutEmptyFavorite"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_home_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textColor="#B65B45"
                android:textSize="55sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="No Favorites Yet"
                android:textColor="#38251C"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Yuk, pilih menu favoritmu di halaman Home!"
                android:textColor="#927967"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- DYNAMIC FAVORITE LIST -->
        <LinearLayout
            android:id="@+id/layoutFavoriteList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:text="Made with love ☕"
            android:textColor="#A99787"
            android:textSize="11sp"/>

    </LinearLayout>
</ScrollView>